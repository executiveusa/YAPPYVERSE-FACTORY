{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pauliverse.internal/schemas/event-envelope.schema.json",
  "title": "Pauliverse Event Envelope",
  "type": "object",
  "required": [
    "schema_version", "event_id", "occurred_at", "source_node", "actor",
    "event_type", "severity", "summary", "evidence_refs", "correlation_id"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "source_node": { "type": "string", "minLength": 1 },
    "actor": {
      "type": "string",
      "enum": ["hermes", "pi", "specialist", "human", "system", "paulis-place", "yappyverse-factory"]
    },
    "event_type": {
      "type": "string",
      "enum": [
        "mission.started", "mission.completed", "mission.blocked",
        "approval.requested", "approval.granted", "approval.denied",
        "opportunity.discovered", "opportunity.routed", "experiment.started", "experiment.completed",
        "deployment.changed", "node.health_changed", "node.disposition_changed",
        "evidence.added", "decision.recorded", "council.completed", "worker.delegated", "worker.returned"
      ]
    },
    "mission_id": { "type": ["string", "null"] },
    "node_id": { "type": ["string", "null"] },
    "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
    "summary": { "type": "string", "minLength": 1 },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "correlation_id": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": ["string", "null"] },
    "requires_human_approval": { "type": "boolean", "default": false },
    "approval_ref": { "type": ["string", "null"] },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
